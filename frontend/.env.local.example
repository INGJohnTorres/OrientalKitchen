# "/api" = la API del propio proyecto (app/api/*). Sin esta variable, modo demo (localStorage).
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WHATSAPP_NUMBER=573115243043
NEXT_PUBLIC_RESTAURANT_NAME="Oriental Kitchen"

# Base de datos y sesiones (solo servidor). Con Supabase: DATABASE_URL = pooler (6543,
# ?pgbouncer=true&connection_limit=1), DIRECT_URL = conexion directa (5432).
DATABASE_URL="postgresql://usuario:password@localhost:5432/restaurante"
DIRECT_URL="postgresql://usuario:password@localhost:5432/restaurante"
JWT_SECRET="un-secreto-largo-y-aleatorio"

# Opcional: aviso por correo de pedidos nuevos.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=tu-contraseña-de-aplicacion
# RESTAURANT_EMAIL=cocina@tu-restaurante.com

